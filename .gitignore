# Rust
/target
**/target
**/*.rs.bk
# Keep workspace Cargo.lock for reproducible CI builds

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets & local vault data (never commit)
*.vault
*.enclave.json
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12

# Node / Flutter / Tauri (future phases)
node_modules/
dist/
apps/extension/dist/
apps/extension/playwright-report/
apps/extension/test-results/
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
apps/desktop/src-tauri/target/
apps/mobile/android/app/src/main/jniLibs/**/*.so
apps/mobile/windows/runner/vault_ffi.dll

# Test / coverage / security reports
coverage/
lcov.info
*.lcov
playwright-report/
test-results/
zap-report/
.cargo-audit/

